datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum ParchiStatus {
  PENDING
  PARTIAL
  PAID
  ADDED_TO_KHATA
  RETURNED
}

enum KhataType {
  PARCHI_ADDED
  KHATA_PAYMENT
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  username  String   @unique
  password  String
  role      Role
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedParchis Parchi[]
  collections     Collection[]
}

model Shopkeeper {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  shopName  String
  ownerName String
  phone     String?
  address   String?
  notes     String?
  hasKhata  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parchis      Parchi[]
  collections  Collection[]
  khataEntries KhataEntry[]
}

model Parchi {
  id     String      @id @default(auto()) @map("_id") @db.ObjectId
  date   DateTime
  amount Float
  status ParchiStatus @default(PENDING)

  shopkeeperId String     @db.ObjectId
  shopkeeper   Shopkeeper @relation(fields: [shopkeeperId], references: [id])

  employeeId String @db.ObjectId
  employee   User   @relation(fields: [employeeId], references: [id])

  collection Collection?

  // Return tracking (employee brought parchi back without collecting)
  returnReason String?
  returnedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([shopkeeperId])
  @@index([employeeId])
}

model Collection {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime

  // Parchi settlement
  parchiAmount    Float
  discount        Float   @default(0)
  discountReason  String?
  goodsAdjustment Float   @default(0)
  goodsDescription String?
  netParchiAmount Float

  // Payments toward today's parchi
  cashPayment    Float   @default(0)
  onlinePayment  Float   @default(0)
  onlineMethod   String?
  onlineVerified Boolean @default(false)
  addedToKhata   Float   @default(0)

  // Payment against OLD khata (separate tracking)
  khataPayment        Float   @default(0)
  khataPaymentCash    Float   @default(0)
  khataPaymentOnline  Float   @default(0)
  khataOnlineMethod   String?
  khataOnlineVerified Boolean @default(false)

  notes String?

  parchiId String @unique @db.ObjectId
  parchi   Parchi @relation(fields: [parchiId], references: [id])

  shopkeeperId String     @db.ObjectId
  shopkeeper   Shopkeeper @relation(fields: [shopkeeperId], references: [id])

  collectedById String @db.ObjectId
  collectedBy   User   @relation(fields: [collectedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([shopkeeperId])
}

model KhataEntry {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime
  amount       Float
  type         KhataType
  description  String?
  balanceAfter Float

  shopkeeperId String     @db.ObjectId
  shopkeeper   Shopkeeper @relation(fields: [shopkeeperId], references: [id])

  collectionId String? @db.ObjectId

  createdAt DateTime @default(now())

  @@index([shopkeeperId])
  @@index([date])
}
